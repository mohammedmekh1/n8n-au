    {
      "id": "wed-code-003",
      "name": "Code – Generate SpecialEvent Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "\n// [COMPANY_NAME] – F12 – Generate SpecialEvent Page Link\nconst d = $input.first().json;\nconst slug = (d.name || 'special_service').toLowerCase()\n  .replace(/\\s+/g, '-')\n  .replace(/[^a-z0-9\\u0600-\\u06FF-]/g, '')\n  .slice(0, 30) + '-' + d.order_id.slice(-6).toLowerCase();\n\nconst page_url = `https://[COMPANY_NAME].sa/special_service/${slug}`;\nconst qr_url   = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(page_url)}`;\nconst preview  = `https://[COMPANY_NAME].sa/special_service/preview/${slug}`;\n\nreturn [{ json: {\n  ...d,\n  special_service_slug:  slug,\n  page_url,\n  qr_url,\n  preview_url:   preview,\n  share_message: `🎊 يسعدنا دعوتكم لحضور حفل مناسبة خاصة ${d.name}${d.partner_name ? ' و' + d.partner_name : ''}\\n📅 ${d.special_service_date}\\n📍 ${d.venue || 'يُعلَن لاحقاً'}\\n\\n✨ تفاصيل الدعوة: ${page_url}\\n📲 رمز QR: ${qr_url}`,\n}}];\n"
      }
    },
