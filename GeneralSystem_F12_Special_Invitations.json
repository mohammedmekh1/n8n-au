    {
      "id": "wed-code-001",
      "name": "Code – Normalize SpecialEvent Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\n// [COMPANY_NAME] – F12 – SpecialEvent Invitation Order Normalizer\nconst raw = $input.first()?.json || {};\nconst d = raw.body || raw;\n\n// استخراج بيانات الطلب\nconst phone   = (d.phone || d.groom_phone || d.bride_phone || '').replace(/[^\\d+]/g,'');\nconst name    = d.groom_name || d.contact_name || d.name || 'صاحب الطلب';\nconst partner = d.bride_name || d.partner_name || '';\nconst special_service_date = d.special_service_date || d.event_date || '';\nconst venue   = d.venue || d.location || '';\nconst package_type = d.package || d.package_type || 'standard';\nconst lang    = d.language || d.lang || 'ar';\nconst msg     = d.message || d.notes || d.special_requests || '';\n\n// توليد order_id فريد\nconst order_id = 'WED-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2,5).toUpperCase();\n\n// تحديد السعر حسب الباقة\nconst PRICES = {\n  basic:    { price: 299, desc: 'دعوة رقمية أساسية + QR Code' },\n  standard: { price: 599, desc: 'دعوة تفاعلية + صفحة حضور + QR' },\n  premium:  { price: 999, desc: 'دعوة VIP + فيديو + موشن + صفحة كاملة' },\n  vip:      { price: 1499, desc: 'باقة مميزة شاملة + تصميم خاص + دعم مباشر' },\n};\nconst pkg = PRICES[package_type] || PRICES.standard;\n\nreturn [{ json: {\n  order_id,\n  lead_id:       d.lead_id || order_id,\n  phone:         phone.startsWith('+') ? phone : '+966' + phone.replace(/^0/,''),\n  name,\n  partner_name:  partner,\n  email:         d.email || '',\n  special_service_date,\n  venue,\n  package_type,\n  package_price: pkg.price,\n  package_desc:  pkg.desc,\n  language:      lang,\n  special_requests: msg,\n  source:        d.source || '[COMPANY_NAME]_Website',\n  platform:      d.platform || 'Website',\n  status:        'new',\n  payment_status:'pending',\n  created_at:    new Date().toISOString(),\n  flow_origin:   '[COMPANY_NAME]_F12_SpecialEvent',\n  service_type:  'special_service',\n  category:      'HOT',\n  score:         85,\n  is_special_service:    true,\n}}];\n"
      }
    },
    {
      "id": "wed-code-002",
      "name": "Code – Validate Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\n// [COMPANY_NAME] – F12 – Validate SpecialEvent Order\nconst d = $input.first().json;\nconst errors = [];\n\nif (!d.phone || d.phone.length < 10) errors.push('رقم الهاتف مفقود أو غير صالح');\nif (!d.name || d.name.length < 2)    errors.push('اسم العريس/العروس مفقود');\nif (!d.special_service_date)                  errors.push('تاريخ المناسبة خاصة مفقود');\nif (!d.package_type)                  errors.push('نوع الباقة غير محدد');\n\nconst valid = errors.length === 0;\nreturn [{ json: { ...d, is_valid: valid, validation_errors: errors.join(' | ') }}];\n"
      }
    },
