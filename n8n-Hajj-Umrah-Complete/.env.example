# ============================================
# ملف إعدادات البيئة - المنظومة العالمية للحج والعمرة
# ============================================
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية

# ============================================
# إعدادات قاعدة البيانات
# ============================================
DB_PASSWORD=secure_password_change_me_123

# ============================================
# إعدادات n8n
# ============================================
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# ============================================
# مفاتيح API (ضع مفاتيحك الحقيقية هنا)
# ============================================
OPENAI_API_KEY=sk-your-openai-key-here
APIFY_API_KEY=your-apify-key-here

# ============================================
# إعدادات MinIO (تخزين الملفات)
# ============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_change_me

# ============================================
# إعدادات Telegram Bot (للإشعارات المجانية)
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id-here

# ============================================
# إعدادات إضافية اختيارية
# ============================================
# HUGGINGFACE_API_KEY=hf-your-key-here
# GOOGLE_MAPS_API_KEY=your-key-here
