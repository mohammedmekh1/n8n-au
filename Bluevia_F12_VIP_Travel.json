    {
      "id": "wed-code-001",
      "name": "Code – Normalize VIP Travel Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\n// Bluevia – F12 – VIP Travel Order Normalizer\nconst raw = $input.first()?.json || {};\nconst d = raw.body || raw;\n\n// استخراج بيانات الطلب\nconst phone   = (d.phone || '').replace(/[^\\d+]/g,'');\nconst name    = d.name || 'عميل VIP';\nconst travel_date = d.travel_date || d.start_date || '';\nconst destination = d.destination || 'تركيا';\nconst package_type = d.package || 'vip_gold';\n\n// توليد order_id فريد\nconst order_id = 'VIP-' + Date.now().toString(36).toUpperCase();\n\n// باقات السفر VIP\nconst PRICES = {\n  vip_silver: { price: 2500, desc: 'سائق خاص + فنادق 4 نجوم مميزة' },\n  vip_gold:   { price: 5000, desc: 'سائق خاص + فنادق 5 نجوم + رحلات يومية' },\n  vip_diamond:{ price: 10000, desc: 'خدمة استقبال VIP + فنادق بوسفور + هليكوبتر' },\n};\nconst pkg = PRICES[package_type] || PRICES.vip_gold;\n\nreturn [{ json: {\n  order_id,\n  lead_id:       d.lead_id || order_id,\n  phone:         phone.startsWith('+') ? phone : '+966' + phone.replace(/^0/,''),\n  name,\n  email:         d.email || '',\n  travel_date,\n  destination,\n  package_type,\n  package_price: pkg.price,\n  package_desc:  pkg.desc,\n  special_requests: d.notes || '',\n  status:        'new',\n  created_at:    new Date().toISOString(),\n  flow_origin:   'Bluevia_F12_VIP',\n  service_type:  'vip_travel',\n  category:      'HOT',\n  score:         95\n}}];\n"
      }
    },
    {
      "id": "wed-code-002",
      "name": "Code – Validate Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\n// Bluevia – F12 – Validate طلب سفر VIP\nconst d = $input.first().json;\nconst errors = [];\n\nif (!d.phone || d.phone.length < 10) errors.push('رقم الهاتف مفقود أو غير صالح');\nif (!d.name || d.name.length < 2)    errors.push('اسم العميل VIP مفقود');\nif (!d.travel_date)                  errors.push('تاريخ السفر مفقود');\nif (!d.package_type)                  errors.push('نوع الباقة غير محدد');\n\nconst valid = errors.length === 0;\nreturn [{ json: { ...d, is_valid: valid, validation_errors: errors.join(' | ') }}];\n"
      }
    },
