      "id": "wed-wh-001",
      "name": "Webhook – VIP Travel Order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "bluevia-vip-order",
