    {
      "parameters": {
        "jsCode": "const k = $input.first().json;\n\nconst num = (val, def = 0) => {\n  const n = parseFloat(val);\n  return isNaN(n) ? def : n;\n};\n\nconst insights = [];\nlet overall_rating = '✅ جيد';\nlet action_items = [];\n\nconst total_leads = num(k.total_leads);\nif (total_leads === 0) {\n  insights.push('⚠️ لا يوجد عملاء جدد اليوم – تحقق من عمل Flow #1 Radar و Flow #2');\n  overall_rating = '🔴 تنبيه';\n  action_items.push('تحقق من تشغيل Flow #1 Radar');\n} else if (total_leads >= 20) {\n  insights.push(`🚀 يوم ممتاز! ${total_leads} عميل جديد`);\n} else if (total_leads >= 10) {\n  insights.push(`📈 أداء جيد – ${total_leads} عميل جديد`);\n} else {\n  insights.push(`📊 ${total_leads} عميل اليوم – أداء طبيعي`);\n}\n\nconst hot_leads = num(k.hot_leads);\nif (total_leads > 0) {\n  const hotRatio = Math.round((hot_leads / total_leads) * 100);\n  if (hotRatio >= 30) insights.push(`🔥 ${hotRatio}% من الـ Leads كانوا Hot – جودة ممتازة!`);\n  else if (hotRatio >= 15) insights.push(`🌡️ ${hotRatio}% Leads Hot – جيد`);\n  else insights.push(`❄️ نسبة Hot منخفضة ${hotRatio}% – راجع إعدادات Radar`);\n}\n\nconst convRate = num(k.lead_to_order_rate);\nif (convRate >= 15) { \n  insights.push(`💰 تحويل ممتاز ${convRate}%!`); \n  overall_rating = '🟢 ممتاز'; \n}\nelse if (convRate >= 8) { \n  insights.push(`💼 تحويل جيد ${convRate}%`); \n}\nelse if (convRate > 0) { \n  insights.push(`📉 تحويل ${convRate}% – فرصة للتحسين`); \n}\nelse if (total_leads > 0) { \n  insights.push('⚠️ لا يوجد طلبات اليوم – راجع فريق المبيعات'); \n  action_items.push('متابعة Hot Leads المفتوحة'); \n}\n\nconst deliveryRate = num(k.delivery_rate);\nconst total_deliveries = num(k.total_deliveries);\nif (deliveryRate < 80 && total_deliveries > 5) {\n  insights.push(`📨 معدل الإرسال ${deliveryRate}% – راجع إعدادات WhatsApp/Telegram`);\n  overall_rating = overall_rating === '🟢 ممتاز' ? '🟡 يحتاج متابعة' : overall_rating;\n  action_items.push('مراجعة delivery_log للفشل');\n}\n\nconst escalated = num(k.escalated);\nif (escalated > 0) {\n  insights.push(`🚨 ${escalated} مهمة مبيعات تم تصعيدها – يحتاج متابعة فورية!`);\n  overall_rating = overall_rating === '🟢 ممتاز' ? '🟡 يحتاج متابعة' : overall_rating;\n  action_items.push('إغلاق المهام المصعّدة');\n}\n\nconst avgScore = num(k.avg_score);\nif (avgScore > 0) {\n  const scoreStatus = avgScore >= 70 ? 'مرتفع 🟢' : avgScore >= 50 ? 'متوسط 🟡' : 'منخفض 🔴';\n  insights.push(`📊 متوسط جودة الـ Leads: ${avgScore}/100 – ${scoreStatus}`);\n}\n\nconst week_leads = num(k.week_leads);\nconst weekAvg = week_leads > 0 ? Math.round(week_leads / 7) : 0;\nconst todayVsWeek = total_leads - weekAvg;\n\nif (week_leads > 0 && Math.abs(todayVsWeek) >= 2) {\n  const direction = todayVsWeek > 0 ? '📈 أعلى' : '📉 أقل';\n  insights.push(`${direction} من متوسط الأسبوع بـ ${Math.abs(todayVsWeek)} عميل`);\n}\n\nreturn [{ json: {\n  ...k,\n  insights: insights.join('\\n'),\n  overall_rating,\n  action_items: action_items.length > 0 \n    ? '⚡ إجراءات مطلوبة:\\n' + action_items.map((a,i) => `${i+1}. ${a}`).join('\\n') \n    : ''\n} }];"
      },
