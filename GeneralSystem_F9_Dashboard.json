    {
      "parameters": {
        "chatId": "=5292626260",
        "text": "={{ \n  (() => {\n    const k = $json || {};\n    \n    // 🔧 دالة مساعدة للأرقام\n    const num = (val, def = 0) => {\n      const n = parseFloat(val);\n      return (n != null && !isNaN(n)) ? n : def;\n    };\n    \n    // ✅ حماية من rating غير موجود\n    const rating = k.overall_rating || 'جديد';\n    const ratingBg = rating.includes('ممتاز') ? '🟢' : rating.includes('تنبيه') ? '🔴' : '🟡';\n    \n    let report = `📊 *تقرير الأداء اليومي – [COMPANY_NAME]*\\n`;\n    report += `📅 ${k.report_date_ar || 'غير متاح'}\\n`;\n    report += `${ratingBg} التقييم: *${rating}*\\n\\n`;\n\n    report += `━━━ 👥 *العملاء المحتملون* ━━━\\n`;\n    report += `📥 إجمالي: *${num(k.total_leads)}* | 🔥 Hot: *${num(k.hot_leads)}* | 🌿 Warm: *${num(k.warm_leads)}*\\n`;\n    report += `📡 Radar: ${num(k.from_radar)} | 💬 WA: ${num(k.from_whatsapp)} | 🌐 Form: ${num(k.from_form)} | ✈️ TG: ${num(k.from_telegram)}\\n`;\n    report += `📈 متوسط الدرجة: *${num(k.avg_score, '0')}/100*\\n\\n`;\n\n    report += `━━━ 💰 *الطلبات والتحويل* ━━━\\n`;\n    report += `✅ طلبات: *${num(k.orders)}* (B2C: ${num(k.b2c_booked, 0)} | B2B: ${num(k.b2b_booked, 0)})\\n`;\n    report += `📊 Lead → طلب: *${num(k.lead_to_order_rate, '0')}%* | Hot → طلب: *${num(k.hot_to_order_rate, '0')}%*\\n\\n`;\n\n    report += `━━━ 📨 *الإرسال* ━━━\\n`;\n    report += `📤 إجمالي: ${num(k.total_deliveries)} | ✅ ناجح: ${num(k.delivered, 0)} | ❌ فشل: ${num(k.failed, 0)}\\n`;\n    report += `معدل النجاح: *${num(k.delivery_rate, '0')}%* | WA: ${num(k.wa_delivered, 0)} | TG: ${num(k.tg_delivered, 0)}\\n\\n`;\n\n    report += `━━━ 📋 *مهام المبيعات* ━━━\\n`;\n    report += `🟢 مغلقة: ${num(k.closed_tasks)} | 🟡 مفتوحة: ${num(k.open_tasks)} | 🔴 مصعّدة: ${num(k.escalated, 0)}\\n`;\n    if (k.avg_close_min > 0) report += `⏱️ متوسط الإغلاق: ${k.avg_close_min} دقيقة\\n`;\n    report += `\\n━━━ 📅 *آخر 7 أيام* ━━━\\n`;\n    report += `👥 ${num(k.week_leads)} lead | 🔥 ${num(k.week_hot, 0)} hot | ✅ ${num(k.week_booked, 0)} طلب | نسبة: *${num(k.week_conv_rate, '0')}%*\\n\\n`;\n\n    report += `━━━ 💡 *التحليل* ━━━\\n`;\n    report += k.insights || '📊 جاري تحليل البيانات...';\n    \n    if (k.action_items) {\n      report += `\\n\\n${k.action_items}`;\n    }\n    \n    // ✅ السطر الأهم: إرجاع النص النهائي\n    return report;\n  })()\n}}",
        "additionalFields": {
          "disable_notification": true,
          "parse_mode": "Markdown"
        }
      },
