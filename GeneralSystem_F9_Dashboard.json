    {
      "parameters": {
        "jsCode": "const dates = $('Code – Set Report Dates').first().json;\nconst allItems = $input.all();\n\nconsole.log('🔍 DEBUG: Total items received:', allItems.length);\n\nconst clean = (val) => val?.toString().trim().toLowerCase() || '';\nconst getDate = (item) => {\n  const d = item?.created_at || item?.captured_at || item?.sent_at || item?.updated_at;\n  return d?.toString().split('T')[0] || null;\n};\nconst isToday = (dateStr) => dateStr === dates.today;\nconst isThisWeek = (dateStr) => dateStr && dateStr >= dates.week_ago && dateStr <= dates.today;\n\n\nconst leadsRaw = allItems\n  .filter(i => i.json?.journey_step !== undefined || i.json?.radar_intent !== undefined || i.json?.score !== undefined)\n  .map(i => i.json)\n  .filter(j => j?.lead_id);\n\nconsole.log('👥 Leads found:', leadsRaw.length);\n\nconst delivRaw = allItems\n  .filter(i => i.json?.delivery_id !== undefined || i.json?.message_preview !== undefined)\n  .map(i => i.json)\n  .filter(j => {\n    const phone = j?.phone?.toString() || '';\n    return phone && !phone.includes('#ERROR!');\n  });\n\nconsole.log('📨 Deliveries found:', delivRaw.length);\n\nconst tasksRaw = allItems\n  .filter(i => i.json?.task_id !== undefined || i.json?.task_type !== undefined)\n  .map(i => i.json)\n  .filter(j => j?.lead_id || j?.task_id);\n\nconsole.log('📋 Tasks found:', tasksRaw.length);\n\nconst ordersRaw = allItems\n  .filter(i => {\n    const j = i.json;\n    return j?.status !== undefined && \n           j?.journey_step === undefined &&\n           j?.delivery_id === undefined &&\n           j?.task_id === undefined &&\n           j?.lead_id !== undefined;\n  })\n  .map(i => i.json);\n\nconsole.log('💰 Bookings found:', ordersRaw.length);\n\nconst weekRaw = leadsRaw;\n\n\nconst uniqueLeads = {};\nleadsRaw.forEach(l => {\n  const id = l.lead_id;\n  if (!id) return;\n  const updatedAt = new Date(l.updated_at || l.created_at || 0);\n  if (!uniqueLeads[id] || updatedAt > new Date(uniqueLeads[id].updated_at || uniqueLeads[id].created_at || 0)) {\n    uniqueLeads[id] = l;\n  }\n});\nconst leadsArray = Object.values(uniqueLeads);\nconsole.log('✨ Unique leads after dedup:', leadsArray.length);\n\nconst todayLeads = leadsArray.filter(l => isToday(getDate(l)));\nconsole.log('📅 Today leads:', todayLeads.length, '(date:', dates.today + ')');\n\nconst weekLeadsArray = leadsArray.filter(l => isThisWeek(getDate(l)));\n\nconst total_leads = todayLeads.length;\nconst hot_leads = todayLeads.filter(l => clean(l.journey_step) === 'hot_contacted' || clean(l.status) === 'hot').length;\nconst warm_leads = todayLeads.filter(l => clean(l.journey_step)?.includes('warm') || clean(l.status) === 'warm').length;\nconst cold_leads = todayLeads.filter(l => clean(l.journey_step)?.includes('cold') || clean(l.status) === 'cold').length;\n\nconst avg_score = todayLeads.length > 0 \n  ? (todayLeads.reduce((sum, l) => sum + (parseFloat(l.score) || 0), 0) / todayLeads.length).toFixed(1)\n  : '0';\n\nconst from_radar = todayLeads.filter(l => clean(l.source)?.includes('radar')).length;\nconst from_whatsapp = todayLeads.filter(l => clean(l.source)?.includes('whatsapp')).length;\nconst from_form = todayLeads.filter(l => clean(l.source) === 'form').length;\nconst from_telegram = todayLeads.filter(l => clean(l.source)?.includes('telegram')).length;\n\n\nconst validDeliveries = delivRaw.filter(d => {\n  if (!d.sent_at) return false;\n  if (d.lead_id?.toString()?.includes('test_') || d.flow_trigger === 'manual_test') return false;\n  return isToday(getDate(d)) && clean(d.status) !== 'empty';\n});\n\nconst total_deliveries = validDeliveries.length;\nconst delivered = validDeliveries.filter(d => clean(d.status) === 'delivered').length;\nconst failed = validDeliveries.filter(d => clean(d.status) === 'failed').length;\nconst delivery_rate = total_deliveries > 0 ? ((delivered / total_deliveries) * 100).toFixed(1) : '0';\n\nconst wa_delivered = validDeliveries.filter(d => clean(d.channel) === 'whatsapp' && clean(d.status) === 'delivered').length;\nconst tg_delivered = validDeliveries.filter(d => clean(d.channel) === 'telegram' && clean(d.status) === 'delivered').length;\n\n\nconst cleanTasks = tasksRaw.map(t => ({\n  ...t,\n  priority: clean(t.priority),\n  status: clean(t.status)\n}));\n\nconst todayTasks = cleanTasks.filter(t => {\n  const d = t.created_at?.split('T')[0];\n  return d === dates.today || d === dates.yesterday;\n});\n\nconst open_tasks = todayTasks.filter(t => t.status === 'open').length;\nconst closed_tasks = todayTasks.filter(t => t.status === 'closed').length;\nconst escalated = todayTasks.filter(t => t.priority === 'urgent' && t.status !== 'closed').length;\n\nconst total_handled = open_tasks + closed_tasks + todayTasks.filter(t => t.status === 'in_progress').length;\nconst task_close_rate = total_handled > 0 ? ((closed_tasks / total_handled) * 100).toFixed(1) : '0';\n\n\nconst validBookings = ordersRaw.filter(b => {\n  return clean(b.status) === 'booked' && isToday(getDate(b)) && !b.archived_at;\n});\n\nconst uniqueBookings = {};\nvalidBookings.forEach(b => {\n  if (!b.lead_id) return;\n  uniqueBookings[b.lead_id] = b;\n});\nconst finalBookings = Object.values(uniqueBookings);\n\nconst orders = finalBookings.length;\nconst b2b_booked = finalBookings.filter(b => clean(b.category)?.includes('b2b')).length;\nconst b2c_booked = finalBookings.filter(b => clean(b.category)?.includes('b2c')).length;\n\n\nconst week_leads = weekLeadsArray.length;\nconst week_hot = weekLeadsArray.filter(l => clean(l.journey_step) === 'hot_contacted' || clean(l.status) === 'hot').length;\nconst week_booked = weekLeadsArray.filter(l => clean(l.status) === 'booked').length;\nconst week_avg_score = weekLeadsArray.length > 0 \n  ? (weekLeadsArray.reduce((sum, l) => sum + (parseFloat(l.score) || 0), 0) / weekLeadsArray.length).toFixed(1)\n  : '0';\nconst week_conv_rate = week_leads > 0 ? ((week_booked / week_leads) * 100).toFixed(1) : '0';\n\n\nconst lead_to_order_rate = total_leads > 0 ? ((orders / total_leads) * 100).toFixed(1) : '0';\nconst hot_to_order_rate = hot_leads > 0 ? ((orders / hot_leads) * 100).toFixed(1) : '0';\n\n\nreturn [{ json: {\n  report_date_ar: dates.report_date_ar,\n  report_date_iso: dates.report_date_iso,\n  generated_at: dates.generated_at,\n\n  total_leads, hot_leads, warm_leads, cold_leads, avg_score,\n  from_radar, from_whatsapp, from_form, from_telegram,\n\n  total_deliveries, delivered, failed, delivery_rate, wa_delivered, tg_delivered,\n\n  open_tasks, closed_tasks, escalated, task_close_rate,\n\n  orders, b2b_booked, b2c_booked, lead_to_order_rate, hot_to_order_rate,\n\n  week_leads, week_hot, week_booked, week_avg_score, week_conv_rate,\n\n  _debug: {\n    total_items_received: allItems.length,\n    leads_found: leadsRaw.length,\n    deliveries_found: delivRaw.length,\n    tasks_found: tasksRaw.length,\n    orders_found: ordersRaw.length,\n    unique_leads_count: leadsArray.length,\n    today_leads_count: total_leads,\n    valid_deliveries_count: validDeliveries.length,\n    valid_orders_count: finalBookings.length,\n    filters_applied: {\n      today: dates.today,\n      week_ago: dates.week_ago,\n      orders_status_required: 'booked'\n    }\n  }\n} }];"
      },
      "name": "Code – Calculate All KPIs",
      "type": "n8n-nodes-base.code",
