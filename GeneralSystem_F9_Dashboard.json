      "parameters": {
        "jsCode": "const now = new Date();\n\nconst riyadhNow = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Riyadh' }));\n\nconst todayStr = riyadhNow.toISOString().split('T')[0];\nconst yesterdayStr = new Date(riyadhNow.getTime() - 86400000).toISOString().split('T')[0];\nconst weekAgoStr = new Date(riyadhNow.getTime() - 7 * 86400000).toISOString().split('T')[0];\nconst monthAgoStr = new Date(riyadhNow.getTime() - 30 * 86400000).toISOString().split('T')[0];\n\nconst reportDateAr = riyadhNow.toLocaleDateString('ar-SA', { \n  weekday: 'long', \n  year: 'numeric', \n  month: 'long', \n  day: 'numeric' \n});\n\nconst generatedAtRiyadh = new Date().toLocaleString('en-CA', { \n  timeZone: 'Asia/Riyadh',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  hour12: false\n}).replace(',', 'T');\n\nreturn [{ json: {\n  today: todayStr,           // \"2026-03-19\"\n  yesterday: yesterdayStr,   // \"2026-03-18\"\n  week_ago: weekAgoStr,      // \"2026-03-12\"\n  month_ago: monthAgoStr,    // \"2026-02-17\" (30 يوم، ليس شهرًا قمريًا)\n  report_date_ar: reportDateAr, // \"الخميس، ١٩ مارس ٢٠٢٦\"\n  report_date_iso: todayStr,    // للمقارنة مع التواريخ الأيزو\n  generated_at: generatedAtRiyadh, // \"2026-03-19T20:53:44\" بتوقيت الرياض\n  timezone: 'Asia/Riyadh'    // للتدقيق\n} }];"
      },
